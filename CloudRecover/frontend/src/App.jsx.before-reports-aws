import { useCallback, useEffect, useState } from "react";
import {
  Activity,
  AlertTriangle,
  CheckCircle2,
  Clock3,
  Cloud,
  Database,
  FileClock,
  HardDrive,
  RotateCcw,
  Plus,
  Wrench,
  Play,
  Pause,
  RefreshCw,
  ShieldCheck,
  ScrollText,
  Server,
  ShieldAlert,
  ClipboardCheck,
  ListChecks,
  Zap,
} from "lucide-react";
import "./App.css";

const API = "http://127.0.0.1:8000";

function formatDate(value) {
  if (!value) return "—";
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? "—" : date.toLocaleString();
}

function statusClass(value = "") {
  const status = String(value).toLowerCase();
  if (["healthy", "succeeded", "success", "ready", "completed", "passed", "pass"].includes(status)) return "healthy";
  if (["failed", "corrupted", "blocked"].includes(status)) return "failed";
  if (["pending", "running", "recovering"].includes(status)) return "pending";
  return "neutral";
}

function App() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);
  const [message, setMessage] = useState("");
  const [lastUpdated, setLastUpdated] = useState(null);
  const [backupService, setBackupService] = useState("payments-api");
  const [recoveryPoint, setRecoveryPoint] = useState("");
  const [drillService, setDrillService] = useState("payments-api");

  const loadDashboard = useCallback(async () => {
    try {
      const response = await fetch(`${API}/api/dashboard`);
      if (!response.ok) throw new Error("Could not load dashboard");
      setData(await response.json());
      setLastUpdated(new Date());
      setMessage("");
    } catch {
      setMessage("Cannot reach the backend. Check that FastAPI is running.");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadDashboard();
    const refreshTimer = window.setInterval(() => {
      if (document.visibilityState === "visible") loadDashboard();
    }, 12000);
    return () => window.clearInterval(refreshTimer);
  }, [loadDashboard]);

  async function post(path, body = {}) {
    setBusy(true);
    setMessage("");
    try {
      const response = await fetch(`${API}${path}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.detail || "Request failed");
      if (result.status === "FAILED") {
        setMessage(`Recovery blocked: ${result.reason}`);
      } else {
        setMessage(result.message || (result.integrity ? `Backup integrity: ${result.integrity}` : result.backup_id ? `Backup ${result.backup_id} created` : `Recovery status: ${result.status ?? "updated"}`));
      }
      await loadDashboard();
      return result;
    } catch (error) {
      setMessage(error.message);
      return null;
    } finally {
      setBusy(false);
    }
  }

  async function simulateFailure(serviceId) {
    if (!window.confirm(`Simulate a failure for ${serviceId}?`)) return;
    const incident = await post("/api/failures", { service_id: serviceId });
    if (incident?.incident_id) {
      if (window.confirm("Failure detected. Run the recovery simulation now?")) {
        await post(`/api/recoveries/${incident.incident_id}/execute`);
      }
    }
  }

  if (loading && !data) {
    return (
      <main className="app loading-screen">
        <div className="brand-mark"><Cloud size={20} /></div>
        <p className="eyebrow">LOCAL DISASTER RECOVERY SIMULATOR</p>
        <h1>CloudRecover</h1>
        <p className="muted">Loading recovery environment…</p>
      </main>
    );
  }

  const summary = data?.summary;
  const analyticsServices = data?.services ?? [];
  const analyticsIncidents = data?.incidents ?? [];
  const terminalIncidents = analyticsIncidents.filter((incident) =>
    ["SUCCEEDED", "FAILED"].includes(String(incident.recovery_status ?? "").toUpperCase())
  );
  const successfulIncidents = terminalIncidents.filter((incident) =>
    String(incident.recovery_status ?? "").toUpperCase() === "SUCCEEDED"
  );
  const timedRecoveries = successfulIncidents.filter((incident) =>
    Number.isFinite(Number(incident.recovery_duration)) && incident.recovery_duration != null
  );
  const rtoMetRecoveries = timedRecoveries.filter((incident) => {
    const target = analyticsServices.find((service) => service.id === incident.service_id)?.rto_target_seconds;
    return target != null && Number(incident.recovery_duration) <= Number(target);
  });
  const rpoMetServices = analyticsServices.filter((service) => service.rpo_met === true).length;
  const latestRecoveryByService = (serviceId) => successfulIncidents.find((incident) => incident.service_id === serviceId && incident.recovery_duration != null);
  const pct = (value, total) => total ? Math.round((value / total) * 100) : null;
  const durationLabel = (value) => value == null ? "No recorded recovery" : `${Number(value).toFixed(1)} s`;

  return (
    <main className="app">
      <header className="topbar">
        <a className="brand" href="#overview" aria-label="CloudRecover overview">
          <span className="brand-mark"><Cloud size={19} /></span>
          <span className="brand-name">CloudRecover<span className="brand-period">.</span></span>
        </a>
        <nav className="nav-links" aria-label="Main navigation">
          <a className="active" href="#overview">Overview</a>
          <a href="#services">Services</a>
          <a href="#analytics">Analytics</a>
          <a href="#drills">Drills</a>
          <a href="#backups">Backups</a>
          <a href="#incidents">Incidents</a>
          <a href="#audit">Audit reports</a>
        </nav>
        <div className="topbar-actions">
          <span className="local-indicator"><span /> Local simulation</span>
          <button className="button-primary" onClick={loadDashboard} disabled={busy}>
            <RefreshCw size={14} className={busy ? "spin" : ""} /> Refresh data
          </button>
        </div>
      </header>

      <section className="hero" id="overview">
        <div className="hero-copy">
          <p className="eyebrow"><span className="eyebrow-line" /> RESILIENCE CONTROL CENTER</p>
          <h1>Disaster recovery <span>readiness report</span></h1>
          <p className="hero-description">
            Monitor backup integrity, service readiness, and recovery activity across your local simulation environment.
          </p>
        </div>
        <div className="report-meta">
          <div className="meta-icon"><ShieldCheck size={19} /></div>
          <div>
            <span className="meta-label">ENVIRONMENT STATUS</span>
            <strong><span className="status-dot" /> Local-only mode</strong>
            <small>No live cloud resources are provisioned</small>
          </div>
        </div>
      </section>

      {message && (
        <div className={`notice ${message.toLowerCase().includes("blocked") || message.toLowerCase().includes("cannot") ? "notice-warning" : ""}`} role="status">
          <AlertTriangle size={16} />
          <span>{message}</span>
          <button className="notice-dismiss" onClick={() => setMessage("")} aria-label="Dismiss message">×</button>
        </div>
      )}

      {data && summary && (
        <>
          <section className="section-block" aria-label="Executive summary">
            <div className="section-title-row">
              <div>
                <p className="eyebrow">01 / EXECUTIVE SUMMARY</p>
                <h2>Recovery posture</h2>
              </div>
              <div className="summary-actions">
                <span className={`simulation-state ${data.auto_simulation?.enabled ? "is-running" : "is-paused"}`}>
                  <span /> {data.auto_simulation?.enabled ? "Auto simulation running" : "Auto simulation paused"}
                </span>
                <div className="simulation-buttons">
                  <button className="button-action" disabled={busy} onClick={() => post("/api/simulation/run-once")}><Play size={12} /> Run once</button>
                  {data.auto_simulation?.enabled ? (
                    <button className="button-action" disabled={busy} onClick={() => post("/api/simulation/pause")}><Pause size={12} /> Pause</button>
                  ) : (
                    <button className="button-primary" disabled={busy} onClick={() => post("/api/simulation/resume")}><Play size={12} /> Resume</button>
                  )}
                </div>
              </div>
            </div>
            <div className="stats">
              <article className="metric-card">
                <div className="metric-top"><span>Monitored services</span><Server size={16} /></div>
                <div className="metric-value">{summary.total_services ?? 0}</div>
                <div className="metric-foot"><span className="metric-mark"><Activity size={12} /></span> Services tracked</div>
              </article>
              <article className="metric-card">
                <div className="metric-top"><span>Healthy services</span><CheckCircle2 size={16} /></div>
                <div className="metric-value">{summary.healthy_services ?? 0}<span className="metric-unit"> / {summary.total_services ?? 0}</span></div>
                <div className="metric-foot"><span className="green-text">●</span> Currently healthy</div>
              </article>
              <article className="metric-card">
                <div className="metric-top"><span>Open incidents</span><ShieldAlert size={16} /></div>
                <div className="metric-value">{summary.open_incidents ?? 0}</div>
                <div className="metric-foot"><span className="metric-mark amber"><AlertTriangle size={12} /></span> Requiring attention</div>
              </article>
              <article className="metric-card featured-metric">
                <div className="metric-top"><span>Average readiness</span><Database size={16} /></div>
                <div className="metric-value">{summary.average_readiness ?? 0}<span className="metric-unit">%</span></div>
                <div className="metric-progress"><span style={{ width: `${Math.max(0, Math.min(100, Number(summary.average_readiness) || 0))}%` }} /></div>
                <div className="metric-foot">Across monitored services</div>
              </article>
            </div>
          </section>

          <section className="section-block" id="services">
            <div className="section-title-row">
              <div>
                <p className="eyebrow">02 / SERVICE INVENTORY</p>
                <h2>Service readiness</h2>
                <p className="section-description">Inspect backup status and simulate a service outage to test recovery readiness.</p>
              </div>
              <span className="outline-tag"><span className="status-dot" /> SIMULATION CONTROLS</span>
            </div>
            <div className="table-panel">
              <div className="table-toolbar">
                <div className="toolbar-title"><Database size={15} /><span>Monitored services</span><span className="count-tag">{data.services?.length ?? 0}</span></div>
                <span className="table-caption">Read-only inventory · Actions affect local simulation data</span>
              </div>
              <div className="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Service</th>
                      <th>Service status</th>
                      <th>Readiness score</th>
                      <th>Latest backup</th>
                      <th>Recovery objectives</th>
                      <th className="action-column">Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(data.services ?? []).map((service) => (
                      <tr key={service.id}>
                        <td>
                          <div className="service-cell">
                            <span className="service-icon"><Database size={16} /></span>
                            <span><strong>{service.name}</strong><small>{service.id}</small></span>
                          </div>
                        </td>
                        <td><span className={`status-pill ${statusClass(service.status)}`}><span />{service.status}</span></td>
                        <td>
                          <div className="readiness-cell">
                            <div className="readiness-number">{service.readiness_score ?? 0}<span>%</span></div>
                            <div className="readiness-track"><span className={Number(service.readiness_score) < 60 ? "low" : ""} style={{ width: `${Math.max(0, Math.min(100, Number(service.readiness_score) || 0))}%` }} /></div>
                            <small>{service.readiness_reason}</small>
                          </div>
                        </td>
                        <td>
                          {service.latest_backup ? (
                            <div className="backup-cell">
                              <span className={`backup-icon ${statusClass(service.latest_backup.integrity)}`}><FileClock size={15} /></span>
                              <span><strong>{service.latest_backup.integrity ?? "Available"}</strong><small>{formatDate(service.latest_backup.created_at)}</small></span>
                            </div>
                          ) : <span className="muted-inline">No backup found</span>}
                        </td>
                        <td>
                          <div className="objective-cell">
                            <span><small>RPO</small><strong>{service.rpo_target_hours ?? "—"}<em>h</em></strong></span>
                            <span><small>RPO status</small><strong className={service.rpo_met ? "green-text" : "amber-text"}>{service.rpo_met == null ? "—" : service.rpo_met ? "Met" : "Missed"}</strong></span>
                            <span><small>RTO</small><strong>{service.rto_target_seconds ?? "—"}<em>s</em></strong></span>
                          </div>
                        </td>
                        <td className="action-column">
                          <button className="button-action" disabled={busy || service.status === "FAILED"} onClick={() => simulateFailure(service.id)}>
                            <Play size={12} /> Simulate
                          </button>
                        </td>
                      </tr>
                    ))}
                    {(!data.services || data.services.length === 0) && <tr><td colSpan="6" className="empty-state">No services returned by the API.</td></tr>}
                  </tbody>
                </table>
              </div>
              <div className="table-footer"><span><span className="footer-led" /> Connected to FastAPI</span><span>RPO = Recovery Point Objective · RTO = Recovery Time Objective</span></div>
            </div>
          </section>

          <section className="section-block" id="analytics">
            <div className="section-title-row">
              <div>
                <p className="eyebrow">03 / RECOVERY ANALYTICS</p>
                <h2>Recovery objectives &amp; outcomes</h2>
                <p className="section-description">Calculated from current backup records and the latest incident history returned by the API. Durations are simulated, not real AWS measurements.</p>
              </div>
              <span className="outline-tag"><Activity size={13} /> DATA-DRIVEN</span>
            </div>
            <div className="stats analytics-stats">
              <article className="metric-card">
                <div className="metric-top"><span>Services meeting RPO</span><Clock3 size={16} /></div>
                <div className="metric-value">{rpoMetServices}<span className="metric-unit"> / {analyticsServices.length}</span></div>
                <div className="metric-progress"><span style={{ width: `${pct(rpoMetServices, analyticsServices.length) ?? 0}%` }} /></div>
                <div className="metric-foot">{pct(rpoMetServices, analyticsServices.length) == null ? "No service data" : `${pct(rpoMetServices, analyticsServices.length)}% currently compliant`}</div>
              </article>
              <article className="metric-card">
                <div className="metric-top"><span>Recorded recoveries meeting RTO</span><Zap size={16} /></div>
                <div className="metric-value">{rtoMetRecoveries.length}<span className="metric-unit"> / {timedRecoveries.length}</span></div>
                <div className="metric-progress"><span style={{ width: `${pct(rtoMetRecoveries.length, timedRecoveries.length) ?? 0}%` }} /></div>
                <div className="metric-foot">{pct(rtoMetRecoveries.length, timedRecoveries.length) == null ? "No timed successful recoveries yet" : `${pct(rtoMetRecoveries.length, timedRecoveries.length)}% of timed successful recoveries`}</div>
              </article>
              <article className="metric-card">
                <div className="metric-top"><span>Recovery success rate</span><ShieldCheck size={16} /></div>
                <div className="metric-value">{pct(successfulIncidents.length, terminalIncidents.length) == null ? "—" : pct(successfulIncidents.length, terminalIncidents.length)}<span className="metric-unit">{terminalIncidents.length ? "%" : ""}</span></div>
                <div className="metric-progress"><span style={{ width: `${pct(successfulIncidents.length, terminalIncidents.length) ?? 0}%` }} /></div>
                <div className="metric-foot">{terminalIncidents.length} completed or failed incidents in the returned history</div>
              </article>
            </div>

            <div className="table-panel analytics-panel">
              <div className="table-toolbar">
                <div className="toolbar-title"><Activity size={15} /><span>Service objective detail</span><span className="count-tag">{analyticsServices.length} services</span></div>
                <span className="table-caption">RPO uses newest backup integrity + age · RTO uses recorded recovery duration</span>
              </div>
              <div className="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>Service</th>
                      <th>Latest backup age</th>
                      <th>RPO target</th>
                      <th>RPO compliance</th>
                      <th>RTO target</th>
                      <th>Latest recorded recovery</th>
                      <th>RTO result</th>
                    </tr>
                  </thead>
                  <tbody>
                    {analyticsServices.map((service) => {
                      const recovery = latestRecoveryByService(service.id);
                      const rtoMet = recovery && recovery.recovery_duration != null
                        ? Number(recovery.recovery_duration) <= Number(service.rto_target_seconds)
                        : null;
                      return (
                        <tr key={service.id}>
                          <td><div className="service-cell"><span className="service-icon"><Database size={15} /></span><span><strong>{service.name}</strong><small>{service.id}</small></span></div></td>
                          <td>{service.backup_age_hours == null ? "No backup" : `${Number(service.backup_age_hours).toFixed(2)} h`}</td>
                          <td>{service.rpo_target_hours ?? "—"} h</td>
                          <td><span className={`status-pill ${service.rpo_met ? "healthy" : "failed"}`}><span />{service.rpo_met ? "MET" : "MISSED"}</span><small className="analytics-reason">{service.readiness_reason}</small></td>
                          <td>{service.rto_target_seconds ?? "—"} s</td>
                          <td>{durationLabel(recovery?.recovery_duration)}</td>
                          <td>{rtoMet == null ? <span className="muted-inline">Not measured</span> : <span className={`status-pill ${rtoMet ? "healthy" : "failed"}`}><span />{rtoMet ? "MET" : "MISSED"}</span>}</td>
                        </tr>
                      );
                    })}
                    {analyticsServices.length === 0 && <tr><td colSpan="7" className="empty-state">No service analytics available.</td></tr>}
                  </tbody>
                </table>
              </div>
              <div className="table-footer"><span><span className="footer-led" /> Derived from stored simulation data</span><span>RTO is only evaluated for successful incidents with a recorded duration.</span></div>
            </div>
          </section>

          <section className="section-block" id="drills">
            <div className="section-title-row">
              <div>
                <p className="eyebrow">04 / RECOVERY SCENARIO ORCHESTRATION</p>
                <h2>Recovery drill runner</h2>
                <p className="section-description">Run a repeatable, non-disruptive drill that checks backup readiness, chooses a recovery point, and evaluates simulated recovery time. It does not change live service state or restore real data.</p>
              </div>
              <span className="outline-tag"><ClipboardCheck size={13} /> SIMULATED DRILL</span>
            </div>
            <div className="table-panel drill-panel">
              <form className="drill-run-form" onSubmit={async (event) => {
                event.preventDefault();
                const result = await post("/api/drills/run", { service_id: drillService });
                if (result) setMessage(`${result.message} · ${result.drill_id} · ${result.readiness_score}/100 readiness`);
              }}>
                <label>Service to test
                  <select value={drillService} onChange={(event) => setDrillService(event.target.value)} disabled={busy}>
                    {(data.services ?? []).map((service) => <option key={service.id} value={service.id}>{service.name}</option>)}
                  </select>
                </label>
                <div className="drill-expectation"><ListChecks size={16} /><span><strong>5-step scenario</strong><small>Detect · Validate · Select · Restore · Check RTO</small></span></div>
                <button className="button-primary" type="submit" disabled={busy || !(data.services ?? []).length}><Play size={13} /> Run recovery drill</button>
              </form>
              <div className="drill-history-heading"><strong><ClipboardCheck size={14} /> Recent drill reports</strong><span>{data.drills?.length ?? 0} saved</span></div>
              {(data.drills ?? []).length === 0 ? (
                <div className="empty-state"><ClipboardCheck size={20} /><strong>No recovery drills yet</strong><span>Choose a service and run your first scenario.</span></div>
              ) : (
                <div className="drill-report-list">
                  {data.drills.map((drill) => (
                    <article className="drill-report" key={drill.id}>
                      <span className={`drill-result-mark ${drill.result === "PASS" ? "healthy" : "failed"}`}>{drill.result === "PASS" ? <CheckCircle2 size={18} /> : <AlertTriangle size={18} />}</span>
                      <div className="drill-report-main">
                        <div className="drill-report-title"><strong>{drill.service_id}</strong><span className={`status-pill ${drill.result === "PASS" ? "healthy" : "failed"}`}><span />{drill.result}</span><small>#{drill.id}</small></div>
                        <small>{formatDate(drill.started_at)} · {drill.duration_seconds ? `${Number(drill.duration_seconds).toFixed(1)}s simulated` : "Restore skipped"}</small>
                        <div className="drill-step-list">
                          {(drill.steps ?? []).map((step, index) => (
                            <div className="drill-step" key={`${drill.id}-${index}`}><span className={`drill-step-dot ${statusClass(step.status)}`} /> <span className="drill-step-name">{step.name}</span><span className={`drill-step-status ${statusClass(step.status)}`}>{step.status}</span><small>{step.detail}</small></div>
                          ))}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              )}
              <div className="table-footer"><span><span className="footer-led" /> Reports persist in local SQLite</span><span>PASS requires a ready backup and meeting the RTO target; FAIL reports a blocked readiness check or missed objective.</span></div>
            </div>
          </section>

          <section className="section-block" id="backups">
            <div className="section-title-row">
              <div>
                <p className="eyebrow">05 / BACKUP MANAGEMENT</p>
                <h2>Backup inventory</h2>
                <p className="section-description">Create and inspect local backup records, or simulate integrity and age problems. These actions do not create real cloud backups.</p>
              </div>
              <span className="outline-tag"><HardDrive size={13} /> LOCAL SQLITE</span>
            </div>
            <div className="backup-manager table-panel">
              <form className="backup-create-form" onSubmit={async (event) => {
                event.preventDefault();
                const result = await post("/api/backups", { service_id: backupService, recovery_point: recoveryPoint.trim() || null });
                if (result) setRecoveryPoint("");
              }}>
                <label>Service
                  <select value={backupService} onChange={(event) => setBackupService(event.target.value)} disabled={busy}>
                    {(data.services ?? []).map((service) => <option key={service.id} value={service.id}>{service.name}</option>)}
                  </select>
                </label>
                <label>Recovery point label <span>(optional)</span>
                  <input value={recoveryPoint} onChange={(event) => setRecoveryPoint(event.target.value)} maxLength={120} placeholder="e.g. pre-release-snapshot" disabled={busy} />
                </label>
                <button className="button-primary" type="submit" disabled={busy || !(data.services ?? []).length}><Plus size={14} /> Create backup</button>
              </form>
              <div className="backup-list-heading"><strong><HardDrive size={14} /> Stored backup records</strong><span>{data.backups?.length ?? 0} records</span></div>
              {(data.backups ?? []).length === 0 ? (
                <div className="empty-state"><HardDrive size={20} /><strong>No backups recorded</strong><span>Create a local backup record to begin.</span></div>
              ) : (
                <div className="backup-record-list">
                  {data.backups.map((backup) => (
                    <article className="backup-record" key={backup.id}>
                      <span className={`backup-record-icon ${statusClass(backup.integrity)}`}><FileClock size={17} /></span>
                      <div className="backup-record-main">
                        <div className="backup-record-title"><strong>{backup.service_name ?? backup.service_id}</strong><span className={`status-pill ${statusClass(backup.integrity)}`}><span />{backup.integrity}</span>{backup.is_latest && <span className="count-tag">LATEST</span>}</div>
                        <code>{backup.recovery_point}</code>
                        <small>ID {backup.id} · Created {formatDate(backup.created_at)}</small>
                      </div>
                      <div className="backup-record-actions">
                        {backup.integrity !== "VALID" ? (
                          <button className="button-action" disabled={busy} onClick={() => post(`/api/backups/${backup.id}/repair`)}><Wrench size={12} /> Mark valid</button>
                        ) : (
                          <button className="button-action" disabled={busy} onClick={() => { if (window.confirm(`Mark backup ${backup.id} as corrupted in the simulation?`)) post(`/api/backups/${backup.id}/corrupt`); }}><AlertTriangle size={12} /> Corrupt</button>
                        )}
                        <button className="button-action" disabled={busy} onClick={() => { if (window.confirm(`Set the backup for ${backup.service_name ?? backup.service_id} to 48 hours old?`)) post(`/api/backups/${backup.service_id}/make-stale`); }}><RotateCcw size={12} /> Make stale</button>
                      </div>
                    </article>
                  ))}
                </div>
              )}
              <div className="table-footer"><span><span className="footer-led" /> Persisted in local SQLite</span><span>“Mark valid” changes simulated integrity status; it does not repair an actual file.</span></div>
            </div>
          </section>

          <div className="lower-grid">
            <section className="section-block lower-section" id="incidents">
              <div className="section-title-row">
                <div><p className="eyebrow">06 / EVENT HISTORY</p><h2>Recovery incidents</h2></div>
                <span className="small-count">{data.incidents?.length ?? 0} records</span>
              </div>
              <div className="activity-panel">
                {(data.incidents ?? []).length === 0 ? (
                  <div className="empty-state"><CheckCircle2 size={20} /><strong>No incidents recorded</strong><span>Run a service simulation to create an incident.</span></div>
                ) : (
                  <div className="incident-list">
                    {data.incidents.map((incident) => (
                      <article className="incident-row" key={incident.id}>
                        <span className={`event-icon ${statusClass(incident.recovery_status)}`}><Zap size={15} /></span>
                        <div className="incident-main">
                          <strong>{incident.service_id}</strong>
                          <span>Incident #{incident.id} · {formatDate(incident.created_at)}</span>
                        </div>
                        <div className="incident-end">
                          <span className={`status-pill ${statusClass(incident.recovery_status)}`}><span />{incident.recovery_status}</span>
                          <small>{incident.recovery_duration == null ? "Duration —" : `${incident.recovery_duration}s simulated`}</small>
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            </section>

            <section className="section-block lower-section" id="audit">
              <div className="section-title-row">
                <div><p className="eyebrow">07 / AUDIT TRAIL</p><h2>System activity</h2></div>
                <span className="small-count">{data.audit?.length ?? 0} events</span>
              </div>
              <div className="activity-panel audit-panel">
                {(data.audit ?? []).length === 0 ? (
                  <div className="empty-state"><ScrollText size={20} /><strong>No audit events</strong><span>Events will appear here as actions occur.</span></div>
                ) : (
                  <div className="audit-list">
                    {data.audit.map((event) => (
                      <article className="audit-row" key={event.id}>
                        <span className="audit-line"><span /></span>
                        <div className="audit-content">
                          <div className="audit-event-heading"><strong>{String(event.event ?? "Event").replaceAll("_", " ")}</strong><time>{formatDate(event.created_at)}</time></div>
                          <p>{event.details}</p>
                        </div>
                      </article>
                    ))}
                  </div>
                )}
              </div>
            </section>
          </div>
        </>
      )}

      <footer className="app-footer">
        <div className="footer-brand"><span className="brand-mark small"><Cloud size={13} /></span><strong>CloudRecover</strong><span>Local disaster recovery simulator</span></div>
        <div className="footer-right"><Clock3 size={13} /> Recovery durations are simulated <span className="footer-separator">/</span> No live AWS resources</div>
      </footer>
    </main>
  );
}

export default App;
